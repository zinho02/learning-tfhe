\citation{crandall1994dwt}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces The roots of $X^8+1$, at the odd multiples of $\pi /8$ on the unit circle. The negacyclic FFT evaluates a polynomial at the four points $\omega _k=e^{i\pi (4k+1)/N}$ (filled). The other four roots (hollow, joined by dotted lines) are their complex conjugates, where a polynomial with real coefficients takes conjugate values, so they do not need to be computed.}}{23}{figure.16}\protected@file@percent }
\newlabel{fig:roots}{{16}{23}{The roots of $X^8+1$, at the odd multiples of $\pi /8$ on the unit circle. The negacyclic FFT evaluates a polynomial at the four points $\omega _k=e^{i\pi (4k+1)/N}$ (filled). The other four roots (hollow, joined by dotted lines) are their complex conjugates, where a polynomial with real coefficients takes conjugate values, so they do not need to be computed}{figure.16}{}}
\@writefile{toc}{\contentsline {paragraph}{Step 3: turn it into a standard FFT.}{23}{paragraph*.32}\protected@file@percent }
\citation{cooley1965fft}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Forward negacyclic transform, drawn for $N=8$. The two halves of the coefficient vector are folded into $N/2$ complex numbers, which are multiplied by the twist factors $e^{i\pi j/N}$. A standard FFT of size $N/2$ then gives the values of $p$ at one root of $X^N+1$ from each conjugate pair. The inverse transform does the same steps in reverse order.}}{24}{figure.17}\protected@file@percent }
\newlabel{fig:fft}{{17}{24}{Forward negacyclic transform, drawn for $N=8$. The two halves of the coefficient vector are folded into $N/2$ complex numbers, which are multiplied by the twist factors $e^{i\pi j/N}$. A standard FFT of size $N/2$ then gives the values of $p$ at one root of $X^N+1$ from each conjugate pair. The inverse transform does the same steps in reverse order}{figure.17}{}}
\@writefile{toc}{\contentsline {paragraph}{Step 4: the FFT itself.}{24}{paragraph*.33}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Is double precision enough?}{24}{paragraph*.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces A DFT of size $4$ computed by the FFT. The inputs are first put in bit-reversed order ($z_0,z_2,z_1,z_3$). Each round combines pairs of values with a \emph  {butterfly}, $(u,v)\DOTSB \mapstochar \rightarrow (u+w\,v,\tmspace  +\thickmuskip {.2777em}u-w\,v)$, where $w$ is a root of unity ($1$, or $i$ for the last pair). A transform of size $M$ needs $\log _2M$ rounds of $M/2$ butterflies.}}{25}{figure.18}\protected@file@percent }
\newlabel{fig:butterfly}{{18}{25}{A DFT of size $4$ computed by the FFT. The inputs are first put in bit-reversed order ($z_0,z_2,z_1,z_3$). Each round combines pairs of values with a \emph {butterfly}, $(u,v)\mapsto (u+w\,v,\;u-w\,v)$, where $w$ is a root of unity ($1$, or $i$ for the last pair). A transform of size $M$ needs $\log _2M$ rounds of $M/2$ butterflies}{figure.18}{}}
