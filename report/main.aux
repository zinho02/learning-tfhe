\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The torus $\mathbb  {T}=\mathbb  {R}/\mathbb  {Z}$ drawn as a circle of length one. (a) The eight messages of $\mathbb  {Z}_8$, placed at the multiples of $1/8$; the shaded slice contains the phases that decode to $1/8$, that is, all points at distance less than $1/16$. (b) The bit encoding used by the gates: \textsf  {true} is $+1/8$ and \textsf  {false} is $-1/8$. Decryption only checks in which half of the circle the phase is, so it allows an error of up to $1/8$ on either side.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:torus}{{2}{4}{The torus $\mathbb {T}=\mathbb {R}/\mathbb {Z}$ drawn as a circle of length one. (a) The eight messages of $\mathbb {Z}_8$, placed at the multiples of $1/8$; the shaded slice contains the phases that decode to $1/8$, that is, all points at distance less than $1/16$. (b) The bit encoding used by the gates: \textsf {true} is $+1/8$ and \textsf {false} is $-1/8$. Decryption only checks in which half of the circle the phase is, so it allows an error of up to $1/8$ on either side}{figure.2}{}}
