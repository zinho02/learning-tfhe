\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces One column of the adder (a full adder): $\mathit  {sum}_i=p_i\oplus c_i$ and $c_{i+1}=\mathrm  {MUX}(p_i;\,c_i,\,x_i)$, with $p_i=x_i\oplus y_i$. When $x_i=y_i$ the outgoing carry is $x_i$, whatever $c_i$ is; otherwise the incoming carry $c_i$ goes through. Each column uses two XOR gates and one MUX, that is, four blind rotations.}}{20}{figure.14}\protected@file@percent }
\newlabel{fig:adder}{{14}{20}{One column of the adder (a full adder): $\mathit {sum}_i=p_i\oplus c_i$ and $c_{i+1}=\mathrm {MUX}(p_i;\,c_i,\,x_i)$, with $p_i=x_i\oplus y_i$. When $x_i=y_i$ the outgoing carry is $x_i$, whatever $c_i$ is; otherwise the incoming carry $c_i$ goes through. Each column uses two XOR gates and one MUX, that is, four blind rotations}{figure.14}{}}
