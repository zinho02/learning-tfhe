\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces A TRGSW ciphertext of $m$, drawn as $2\ell =6$ TRLWE rows $(a_r,b_r)$ that encrypt zero, plus the gadget terms (orange). The external product multiplies each row by one digit polynomial, $u_i$ for the digits of $a$ and $w_i$ for the digits of $b$, and adds the six rows. Adding the phases on the right, the gadget terms rebuild $m(b-a\,s')$ from the digits, while the noise is only multiplied by small digits.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:trgsw}{{4}{8}{A TRGSW ciphertext of $m$, drawn as $2\ell =6$ TRLWE rows $(a_r,b_r)$ that encrypt zero, plus the gadget terms (orange). The external product multiplies each row by one digit polynomial, $u_i$ for the digits of $a$ and $w_i$ for the digits of $b$, and adds the six rows. Adding the phases on the right, the gadget terms rebuild $m(b-a\,s')$ from the digits, while the noise is only multiplied by small digits}{figure.4}{}}
