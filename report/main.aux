\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The blind rotation of Example~\ref {ex:blindrot} ($n=3$, $N=4$, $s=(1,0,1)$, $\bar  b=6$, $\bar  {\mathbf  a}=(3,5,2)$) for any test polynomial $v=v_0+v_1X+v_2X^2+v_3X^3$. Each row is the message of the accumulator (the coefficients of the polynomial it encrypts) after one CMux. The server does the same three CMux operations whatever $s$ is; only the key decides which of them rotate. The final constant coefficient is $v_{\bar  \varphi }=v_1$. With the gate test polynomial ($v_j=\mu $), the rows are the ones in the table of the example.}}{15}{figure.10}\protected@file@percent }
\newlabel{fig:blindrot}{{10}{15}{The blind rotation of Example~\ref {ex:blindrot} ($n=3$, $N=4$, $s=(1,0,1)$, $\bar b=6$, $\bar {\mathbf a}=(3,5,2)$) for any test polynomial $v=v_0+v_1X+v_2X^2+v_3X^3$. Each row is the message of the accumulator (the coefficients of the polynomial it encrypts) after one CMux. The server does the same three CMux operations whatever $s$ is; only the key decides which of them rotate. The final constant coefficient is $v_{\bar \varphi }=v_1$. With the gate test polynomial ($v_j=\mu $), the rows are the ones in the table of the example}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Sample extraction for $N=4$. In the constant coefficient of $a\cdot s'$, each $s'_j$ is multiplied by $a_{N-j}$, with a minus sign for $j\ge 1$. Reordering the mask and changing these signs gives an LWE ciphertext $(a',b_0)$ whose phase, under the coefficients of $s'$, is the constant coefficient of the TRLWE phase. Nothing is computed and no noise is added.}}{15}{figure.11}\protected@file@percent }
\newlabel{fig:extract}{{11}{15}{Sample extraction for $N=4$. In the constant coefficient of $a\cdot s'$, each $s'_j$ is multiplied by $a_{N-j}$, with a minus sign for $j\ge 1$. Reordering the mask and changing these signs gives an LWE ciphertext $(a',b_0)$ whose phase, under the coefficients of $s'$, is the constant coefficient of the TRLWE phase. Nothing is computed and no noise is added}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Step 5: Key Switching}{15}{subsection.3.6}\protected@file@percent }
